POSTGRES_USERNAME=user
POSTGRES_PASSWORD=abc123

# Zitadel (identity provider), values for local development on http://localhost:8081
# production: auth.project101.tech, 443, true, external
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8081
ZITADEL_EXTERNALSECURE=false
ZITADEL_TLS_MODE=disabled
# exactly 32 characters, encrypts the secrets in the zitadel database, never change it later
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_DB_PASSWORD=zitadel
# first admin, login name is <username>@labs-101.<domain>, e.g. admin@labs-101.localhost
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Password1!

# backend: issuer the tokens come from, optional the project id of the app in zitadel
AUTH_ISSUER=http://localhost:8081
# e.g. 123456789012345678, leave empty to accept tokens of every project
AUTH_AUDIENCE=
# organization of the users in zitadel (console: Organization → the id next to the name), backend and
# frontend build the URLs of the profile pictures with it, leave empty for no pictures
ZITADEL_ORG_ID=

# frontend: the web app in zitadel (confidential client, code flow with PKCE)
APP_URL=http://localhost:3000
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=change-me-to-at-least-32-random-characters

# production: generate every password and secret new, the defaults in docker-compose.yml
# already fit production, so only these differ from local development
# ZITADEL_EXTERNALDOMAIN=auth.project101.tech
# ZITADEL_EXTERNALPORT=443
# ZITADEL_EXTERNALSECURE=true
# ZITADEL_TLS_MODE=external
# AUTH_ISSUER=https://auth.project101.tech
# APP_URL=https://project101.tech
