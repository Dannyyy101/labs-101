# Copy to .env (git ignored) for `npm run dev`, values for local development

# backend including the /api prefix
BACKEND_URL=http://localhost:8080/api

# zitadel, has to match the AUTH_ISSUER of the backend
AUTH_ISSUER=http://localhost:8081
# organization of the users in zitadel, for the URLs of the profile pictures
ZITADEL_ORG_ID=

# public URL of the frontend, zitadel redirects back to ${APP_URL}/auth/callback
APP_URL=http://localhost:3000

# web app in zitadel (confidential client, code flow with PKCE)
AUTH_CLIENT_ID=123456789012345678
AUTH_CLIENT_SECRET=change-me-client-secret-from-zitadel

# at least 32 random characters, encrypts the session cookie, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me-to-at-least-32-random-characters
