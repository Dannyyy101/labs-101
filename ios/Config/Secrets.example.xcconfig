// Copy to Secrets.xcconfig (git ignored) and fill in your values.

// backend including the /api prefix, "//" has to be written as "/$()/"
API_BASE_URL = http:/$()/192.168.178.85:8080/api
// zitadel, the tokens have to come from the issuer the backend trusts (AUTH_ISSUER of the backend)
AUTH_ISSUER = https:/$()/auth.project101.tech
// client id of the native app in zitadel, redirect uri labs101://auth/callback
AUTH_CLIENT_ID = 123456789012345678
